FROM node:20-alpine AS build
WORKDIR /appfe
COPY frontend/package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /appfe/dist /usr/share/nginx/html
# If using React Router, copy a custom nginx config to handle client-side routing
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
