# Copy this file to .env.production and replace every placeholder.
# Never commit .env.production.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=people_sync
DB_USERNAME=people_sync_app
DB_PASSWORD=replace-with-a-long-random-password
DB_SSL_MODE=require
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
SERVER_PORT=8080
